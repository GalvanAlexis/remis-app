# Environment variables - COPY to .env and fill with real values

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/remis"

# JWT Secrets
# ⚠️ SECURITY CRITICAL: CHANGE THESE IN PRODUCTION!
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_THIS_TO_RANDOM_64_CHAR_HEX_STRING_IN_PRODUCTION"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_DIFFERENT_64_CHAR_HEX_STRING_IN_PRODUCTION"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Server
PORT=8080
NODE_ENV="development"
